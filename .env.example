# Frontend (Vite) — committed builds read this at build time.
# The absolute URL of the deployed contact function. Leave unset for local
# `vercel dev` (defaults to the same-origin /api/contact).
# For the GitHub Pages build, set it to your Vercel function URL:
#   VITE_CONTACT_ENDPOINT=https://<your-vercel-project>.vercel.app/api/contact
VITE_CONTACT_ENDPOINT=
# Absolute URL of the deployed Spotify now-playing function (same project):
#   VITE_NOWPLAYING_ENDPOINT=https://<your-vercel-project>.vercel.app/api/now-playing
VITE_NOWPLAYING_ENDPOINT=

# Backend (Spotify now-playing) — set in the Vercel project's Environment
# Variables, NOT here. Listed for reference only.
# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...
# SPOTIFY_REFRESH_TOKEN=...

# Backend (Vercel Function) — set these in the Vercel project's Environment
# Variables, NOT in the committed build. Listed here for reference only.
# GMAIL_USER=sa7wik@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-google-app-password
# CONTACT_TO=sa7wik@gmail.com
